# ============================================================
# Blind Glasses Server - Cloudflare Tunnel 雲端模式設定
# 複製此檔為 .env 即可啟用雲端模式：
#   copy .env.cloudflare .env
# ============================================================

# ----- Cloudflare Tunnel Token -----
# 從 Zero Trust Dashboard > Tunnels 取得
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TOKEN_HERE

# ----- 雲端模式：關閉 UDP Discovery -----
# 雲端環境 UDP 廣播不通，ESP32 改用 HTTPS 直連網域
ENABLE_UDP_DISCOVERY=0

# ----- ESP32 串流（雲端模式下通常不可用） -----
# 若 ESP32 在同一區網可留空（走 IP 直連拉流）
# 若 ESP32 也有公開 URL（不太可能），填在這裡：
# ESP32_STREAM_URL=

# ----- API 保護 -----
# 為 ESP32 裝置設定一個簡單的認證 Token（防止未授權存取）
# ESP32 韌體需在 HTTP Header 帶上此 token
DEVICE_API_TOKEN=change-me-to-a-random-string

# ----- Gemini API Key -----
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# ----- Google Maps -----
GOOGLE_MAPS_API_KEY=

# ----- 家的座標 -----
HOME_LAT=25.0
HOME_LNG=121.5

# ----- LINE Bot -----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_IDS=
LINE_NOTIFY_ENABLE=0

# ----- Server -----
HTTP_HOST=0.0.0.0
HTTP_PORT=5000

# ----- LINE Snapshot 基底 URL（改為你的網域） -----
LINE_SNAPSHOT_BASE_URL=https://blind-glasses.org
